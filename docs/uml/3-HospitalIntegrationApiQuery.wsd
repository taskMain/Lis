@startuml HospitalIntegrationApiQuery
!include ddd_lib.puml
' 医院 HIS 外部 API 的正式响应模型与引用详情查询；标准项目和院区对照不在本平台范围内。
' MedicalReportType、VisitType 和 SourceImageStatus 只引用 1-MedicalRecognitionReport.wsd 的全局正式定义。
Person('HospitalHisSystem','医院 HIS')

ReadModel('RecognitionMatchesResponseReadModel')[
    互认匹配响应
    --属性--
    是否存在匹配(HasMatches Boolean)
    互认匹配记录ID(RecognitionMatchRecordId Guid)
    匹配生成时间(MatchCreatedTime DateTime)
    报告集合(Reports RecognitionMatchReportReadModel)
]
ReadModel('RecognitionMatchReportReadModel')[
    匹配报告公共信息
    --属性--
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    报告类型(ReportType MedicalReportType)
    来源报告单号(ReportNo String)
    来源报告名称(ReportName String)
    来源组织编码(SourceOrganizationCode String)
    来源医院编码(SourceHospitalCode String)
    来源医院名称(SourceHospitalName String)
    来源院区编码(SourceBranchCode String)
    来源院区名称(SourceBranchName String)
    检查或检验时间(ClinicalTime DateTime)
    报告时间(ReportTime DateTime)
    文件信息(File PdfAndImageAccessReadModel)
    匹配项目集合(MatchItems RecognitionMatchItemReadModel)
]
ReadModel('RecognitionMatchItemReadModel')[
    项目级匹配内容
    --属性--
    互认匹配项ID(RecognitionMatchItemId Guid)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
    标本类型名称(SpecimenTypeName String)
    主要检验结果(LaboratoryResults RecognitionMatchLaboratoryResultReadModel)
    检查部位集合(ExaminationSites RecognitionExaminationSiteReadModel)
    整体异常标识(OverallAbnormalFlag String)
]
ReadModel('RecognitionMatchLaboratoryResultReadModel')[
    检验匹配主要结果明细
    --属性--
    项目名称(ResultItemName String)
    来源结果原文(SourceResultContent Text)
    单位(Unit String)
    来源参考范围(SourceReferenceRange String)
    来源异常标志(SourceAbnormalFlag String)
    来源危急值标志(SourceCriticalValueFlag String)
]
ReadModel('RecognitionExaminationSiteReadModel')[
    检查部位
    --属性--
    部位名称(SiteName String)
    来源部位编码(SourceSiteCode String)
]

ReadModel('RecognitionCitationDetailReadModel')[
    互认引用详情
    --属性--
    匹配项集合(MatchItems RecognitionCitationItemReadModel)
    报告公共上下文集合(ReportContext RecognitionReportContextReadModel)
]
ReadModel('RecognitionCitationItemReadModel')[
    项目级引用内容
    --属性--
    互认匹配项ID(RecognitionMatchItemId Guid)
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
    检验结果(LaboratoryResults RecognitionCitationLaboratoryResultReadModel)
    检查部位集合(ExaminationSites RecognitionExaminationSiteReadModel)
]
ReadModel('RecognitionCitationLaboratoryResultReadModel')[
    检验引用结果明细
    --属性--
    项目名称(ResultItemName String)
    来源结果原文(SourceResultContent Text)
    单位(Unit String)
    来源参考范围(SourceReferenceRange String)
    来源异常标志(SourceAbnormalFlag String)
    来源危急值标志(SourceCriticalValueFlag String)
]
ReadModel('RecognitionReportContextReadModel')[
    报告公共上下文
    --属性--
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    报告类型(ReportType MedicalReportType)
    来源报告单号(ReportNo String)
    来源报告名称(ReportName String)
    来源组织编码(SourceOrganizationCode String)
    来源医院编码(SourceHospitalCode String)
    来源医院名称(SourceHospitalName String)
    来源院区编码(SourceBranchCode String)
    来源院区名称(SourceBranchName String)
    检查或检验时间(ClinicalTime DateTime)
    报告时间(ReportTime DateTime)
    来源申请医生ID(SourceApplicantDoctorId String)
    来源申请医生名称(SourceApplicantDoctorName String)
    来源审核医生ID(SourceReviewerDoctorId String)
    来源审核医生名称(SourceReviewerDoctorName String)
    检查所见(ExaminationFindings Text)
    检查结论(ExaminationConclusion Text)
    文件信息(File PdfAndImageAccessReadModel)
]
ReadModel('PdfAndImageAccessReadModel')[
    PDF及影像入口
    --属性--
    PDF文件标识(PdfFileId String)
    PDF下载入口(PdfDownloadUrl String)
    PDF原始文件名(PdfOriginalFileName String)
    来源影像状态(SourceImageStatus SourceImageStatus)
    影像调阅地址(ImageAccessUrl String)
]

Query('GetRecognitionCitationDetailApi')[
    获取互认引用详情
    --入参--
    证件类型代码(IdentityDocumentTypeCode String)
    证件号码(IdentityDocumentNo String)
    本次来源就诊类型(VisitType VisitType)
    本次来源就诊流水号(VisitSerialNo String)
]
note right of RecognitionMatchesResponseReadModel
  HasMatches=false 时，正式业务响应中的匹配记录ID和生成时间为 null，报告集合为空。
  当前生成器不保留 ReadModel 可空标记，传输契约仍以 SRS 空结果规则为准。
  Reports、MatchItems、LaboratoryResults 表示集合；同一联合报告公共信息只返回一次。
end note
note right of RecognitionCitationDetailReadModel
  MatchItems、ReportContext、LaboratoryResults 表示集合；可选人员、检查部位、检查所见、检查结论、检验结果的单位/参考范围/异常及危急值字段和影像字段允许无业务值。
  存在可返回项目时仅返回有效项目；全部无可返回项目时按平台实际确认的原因失败，不返回成功空集合。
end note
HospitalHisSystem --> GetRecognitionCitationDetailApi
GetRecognitionCitationDetailApi .. RecognitionCitationDetailReadModel
@enduml
