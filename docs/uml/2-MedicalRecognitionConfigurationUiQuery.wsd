@startuml MedicalRecognitionConfigurationUiQuery
!include ddd_lib.puml
' 管理端 UI 查询：标准目录、互认配置、金额和报告管理。
' 所有查询最终读取唯一 MedicalRecognitionReportAggregate 的实体或其只读投影。
' MedicalItemType、MedicalReportType 和 MedicalReportLifecycleStatus 只引用 1-MedicalRecognitionReport.wsd 的全局正式定义；本文件不重复定义。
Person('PlatformAdministrator','平台管理员')
Person('HospitalAdministrator','医院管理员')
UserInterface('MedicalRecognitionConfigurationModule','互认配置管理模块')
UserInterface('MedicalStandardCatalogManagementModule','标准医疗项目目录管理模块')
UserInterface('RecognitionAmountManagementModule','互认项目金额管理模块')
UserInterface('MedicalReportManagementModule','报告管理模块')

Enum('ConfigurationStatusEnum')[
    配置状态
    --属性--
    启用(Enabled 1)
    停用(Disabled 2)
]

Enum('MedicalStandardUsageStatusEnum')[
    标准目录使用情况
    --属性--
    未使用(Unused 0)
    已使用(InUse 1)
]

ReadModel('MedicalStandardCategoryListReadModel')[
    标准医疗项目分类列表
    --属性--
    分类ID(CategoryId Guid)
    项目类型(ItemType MedicalItemType)
    项目类型中文(ItemTypeText String?)
    分类名称(Name String)
    是否启用(IsValid Boolean)
    备注(Remark String?)
    使用情况(UsageStatus MedicalStandardUsageStatus)
    使用情况中文(UsageStatusText String)
]
ReadModel('MedicalStandardGroupListReadModel')[
    标准医疗项目分组列表
    --属性--
    分组ID(GroupId Guid)
    分类ID(CategoryId Guid)
    分组名称(Name String)
    是否启用(IsValid Boolean)
    备注(Remark String?)
    使用情况(UsageStatus MedicalStandardUsageStatus)
    使用情况中文(UsageStatusText String)
]
ReadModel('MedicalStandardItemListReadModel')[
    标准医疗项目列表
    --属性--
    标准项目ID(ItemId Guid)
    分类ID(CategoryId Guid)
    分组ID(GroupId Guid)
    项目类型(ItemType MedicalItemType)
    项目类型中文(ItemTypeText String?)
    标准项目编码(Code String)
    标准项目名称(Name String)
    是否启用(IsValid Boolean)
    备注(Remark String?)
]
Query('QueryMedicalStandardCategoryList')[
    查询标准医疗项目分类列表
    --入参--
    项目类型(ItemType MedicalItemType?)
]
Query('QueryMedicalStandardGroupList')[
    查询标准医疗项目分组列表
    --入参--
    分类ID(CategoryId Guid?)
]
Query('QueryMedicalStandardItemList')[
    查询标准医疗项目列表
    --入参--
    分类ID(CategoryId Guid?)
    分组ID(GroupId Guid?)
    项目编码(Code String?)
    项目名称(Name String?)
    是否启用(IsValid Boolean?)
]

ReadModel('EffectiveMedicalStandardCatalogReadModel')[
    当前有效标准医疗项目目录
    --属性--
    类型目录(ItemTypes EffectiveMedicalStandardCatalogTypeReadModel)
]
ReadModel('EffectiveMedicalStandardCatalogTypeReadModel')[
    当前有效项目类型目录
    --属性--
    项目类型(ItemType MedicalItemType)
    项目类型中文(ItemTypeText String?)
    分类目录(Categories EffectiveMedicalStandardCatalogCategoryReadModel)
]
ReadModel('EffectiveMedicalStandardCatalogCategoryReadModel')[
    当前有效项目分类目录
    --属性--
    分类名称(CategoryName String)
    分组目录(Groups EffectiveMedicalStandardCatalogGroupReadModel)
]
ReadModel('EffectiveMedicalStandardCatalogGroupReadModel')[
    当前有效项目分组目录
    --属性--
    分组名称(GroupName String)
    项目明细(Items EffectiveMedicalStandardCatalogItemReadModel)
]
ReadModel('EffectiveMedicalStandardCatalogItemReadModel')[
    当前有效项目明细
    --属性--
    标准项目编码(Code String)
    标准项目名称(Name String)
    备注(Remark String?)
    操作人(OperId Guid)
    操作时间(OperTime DateTimeOffset)
]
Query('QueryEffectiveMedicalStandardCatalog')[
    查询当前有效标准医疗项目目录
    --入参--
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
]


ReadModel('RecognitionProjectConfigurationReadModel')[
    标准项目互认配置列表
    --属性--
    互认配置ID(ConfigurationId Guid)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardItemName String)
    项目类型(ItemType MedicalItemType)
    项目类型中文(ItemTypeText String?)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    可互认时间天数(RecognitionDurationDays Integer)
    配置状态(ConfigurationStatus ConfigurationStatus)
    配置状态中文(ConfigurationStatusText String)
    当前不可用原因(UnavailableReason String?)
]
ReadModel('RecognitionAmountReadModel')[
    医院院区互认项目金额
    --属性--
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
    项目类型(ItemType MedicalItemType)
    项目类型中文(ItemTypeText String?)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    组织名称(OrganizationName String)
    医院名称(HospitalName String)
    院区名称(BranchName String)
    互认配置状态(ConfigurationStatus ConfigurationStatus)
    配置状态中文(ConfigurationStatusText String)
    当前不可用原因(UnavailableReason String?)
    当前金额(CurrentAmount Decimal?)
    金额已配置(IsAmountConfigured Boolean)
]
note right of RecognitionProjectConfigurationReadModel
  UnavailableReason 仅表达标准目录停用原因，不表达配置自身停用。
  多层停用按分类、分组、标准项目顺序返回一个原因。
  文案为“所属分类已停用”“所属分组已停用”“标准项目已停用”。
  目录全部启用时返回 null。
end note
note right of MedicalRecognitionConfigurationModule
  平台管理员可选择可信范围内的组织；
  医院管理员只使用可信上下文允许的所属组织。
  菜单与接口操作授权由外部权限系统负责，不在本模块重复建设。
end note
Query('QueryRecognitionProjectConfigurationList')[
    查询标准项目互认配置
    --入参--
    组织编码(OrganizationCode String)
    标准项目编码(StandardProjectCode String?)
    配置状态(ConfigurationStatus ConfigurationStatus?)
]
Query('QueryRecognitionAmountList')[
    查询医院院区互认项目金额
    --入参--
    组织编码(OrganizationCode String)
    医院编码(HospitalCode String)
    院区编码(BranchCode String)
    标准项目编码(StandardProjectCode String?)
]
note right of QueryRecognitionAmountList
  平台管理员入口：组织、医院、院区均取自请求。
  服务端校验该组织、医院、院区存在、启用且父子归属正确。
end note
Query('QueryBranchRecognitionAmountList')[
    查询本院区互认项目金额
    --入参--
    院区编码(BranchCode String)
    标准项目编码(StandardProjectCode String?)
]
note right of QueryBranchRecognitionAmountList
  医院管理员入口：组织与医院取自可信上下文，请求只提交院区。
  服务端校验该院区存在、启用且属于可信医院。
end note

ReadModel('MedicalReportListReadModel')[
    报告列表
    --属性--
    报告ID(ReportId Guid)
    组织编码(OrganizationCode String)
    医院编码(HospitalCode String)
    院区编码(BranchCode String)
    组织名称(OrganizationName String)
    医院名称(HospitalName String)
    院区名称(BranchName String)
    报告类型(ReportType MedicalReportType)
    报告单号(ReportNo String)
    报告时间(ReportTime DateTime)
    当前版本序号(CurrentVersionSequence Integer)
    患者姓名(PatientName String)
    证件号码(IdentityDocumentNo String)
    生命周期状态(Status MedicalReportLifecycleStatus)
]
Query('QueryMedicalReportList')[
    查询报告列表
    --入参--
    组织编码(OrganizationCode String?)
    医院编码(HospitalCode String?)
    院区编码(BranchCode String?)
    开始时间(StartTime DateTime?)
    结束时间(EndTime DateTime?)
    报告类型(ReportType MedicalReportType?)
    报告单号(ReportNo String?)
    证件号码(IdentityDocumentNo String?)
    患者姓名(PatientName String?)
]
ReadModel('MedicalReportVersionListReadModel')[
    报告历史版本列表
    --属性--
    报告版本ID(ReportVersionId Guid)
    平台内部版本序号(VersionSequence Integer)
    源端报告修改时间(SourceModifiedTime DateTime)
    平台接收时间(PlatformReceivedTime DateTime)
    报告医生名称(ReportDoctorName String)
    审核医生名称(ReviewDoctorName String)
    检验人名称(InspectorName String?)
    明细检测人(DetailInspectors String?)
    检查医生名称(ExaminerName String?)
    来源报告备注(SourceReportRemark Text)
    PDF文件名(PdfFileName String)
    是否当前有效版本(IsCurrentVersion Boolean)
    是否已被后续版本替代(IsSuperseded Boolean)
    报告生命周期状态(ReportStatus MedicalReportLifecycleStatus)
]
Query('QueryMedicalReportVersionList')[
    查询报告历史版本列表
    --入参--
    报告ID(ReportId Guid)
]
ReadModel('MedicalReportVersionDetailQueryReadModel')[
    报告版本详情
    --属性--
    报告类型(ReportType MedicalReportType)
    报告单号(ReportNo String)
    报告版本ID(ReportVersionId Guid)
    平台内部版本序号(VersionSequence Integer)
    源端报告修改时间(SourceModifiedTime DateTime)
    平台接收时间(PlatformReceivedTime DateTime)
    报告医生名称(ReportDoctorName String)
    审核医生名称(ReviewDoctorName String)
    检验人名称(InspectorName String?)
    明细检测人(DetailInspectors String?)
    检查医生名称(ExaminerName String?)
    来源报告备注(SourceReportRemark Text)
    报告内容(Content MedicalReportVersionContentReadModel)
    PDF文件(File MedicalReportVersionPdfQueryReadModel)
]
ReadModel('MedicalReportVersionContentReadModel')[
    完整结构化报告内容
    --属性--
    报告公共信息(Common ReportVersionCommonReadModel)
    检验报告内容(LaboratoryContent LaboratoryReportContentReadModel)
    检查报告内容(ExaminationContent ExaminationReportContentReadModel)
]
ReadModel('ReportVersionCommonReadModel')[
    报告公共信息
    --属性--
    患者姓名(PatientName String)
    患者性别代码(PatientGenderCode String)
    患者出生日期(PatientBirthDate DateTime)
    患者联系电话(PatientPhoneNumber String)
    报告时年龄(AgeAtReport String)
    证件类型代码(IdentityDocumentTypeCode String)
    证件号码(IdentityDocumentNo String)
    就诊类型(VisitType VisitType)
    就诊流水号(VisitSerialNo String)
    来源报告名称(SourceReportName String)
    申请科室ID(ApplicationDeptId String)
    申请科室名称(ApplicationDeptName String)
    申请医生ID(ApplicationDoctorId String)
    申请医生名称(ApplicationDoctorName String)
    执行科室ID(ExecutionDeptId String)
    执行科室名称(ExecutionDeptName String)
    报告科室ID(ReportDeptId String)
    报告科室名称(ReportDeptName String)
    报告医生ID(ReportDoctorId String)
    报告医生名称(ReportDoctorName String)
    审核医生ID(ReviewDoctorId String)
    审核医生名称(ReviewDoctorName String)
    审核时间(ReviewTime DateTime)
    住院号(InpatientNo String)
    病区名称(WardName String)
    病房名称(RoomName String)
    床位号(BedNo String)
    申请时间(ApplicationTime DateTime)
    报告时间(ReportTime DateTime)
    来源保密标识(SourceConfidentialFlag String)
]
ReadModel('LaboratoryReportContentReadModel')[
    检验报告结构化内容
    --属性--
    报告类别编码(ReportCategoryCode String)
    报告类别名称(ReportCategoryName String)
    报告备注(ReportRemark Text)
    整体异常标识(OverallAbnormalFlag String)
    来源医嘱流水号(SourceOrderSerialNo String)
    标本采集时间(SpecimenCollectedTime DateTime)
    标本送检时间(SpecimenSubmittedTime DateTime)
    检验科接收时间(LaboratoryReceivedTime DateTime)
    院内标本号(SourceSpecimenNo String)
    标本类型编码(SpecimenTypeCode String)
    标本类型名称(SpecimenTypeName String)
    检测完成时间(TestingCompletedTime DateTime)
    检验人ID(InspectorId String)
    检验人名称(InspectorName String)
    普通检验结果(Results LaboratoryResultReadModel)
    细菌鉴定结果(BacteriaResults LaboratoryBacteriaResultReadModel)
    药敏结果(Susceptibilities LaboratorySusceptibilityReadModel)
]
ReadModel('LaboratoryResultReadModel')[
