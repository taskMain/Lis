@startuml RecognitionStatisticsUiQuery
!include ddd_lib.puml
' 管理端统计与导出查询；统计事实来自唯一 MedicalRecognitionReportAggregate。
' MedicalItemType 和 VisitType 只引用 1-MedicalRecognitionReport.wsd 的全局正式定义。
' 查询与导出均设平台/本院双入口（本院版不携带本侧组织与医院字段，由可信上下文注入）；
' 四个查询请求以内嵌分页对象承载分页，导出为 POST + 全部查询条件体、不使用页面分页。
' 统一关键字（2026-10-20 重开，S6-D19）：统计查询与导出请求以关键字承载互认科室、互认项目与互认医生（明细）
' 条件，替换原互认科室ID、标准项目编码、互认医生ID 三个独立条件字段；不采纳原因代码字段保留。
' 精确分组字段（S6-D22）：四个明细请求与两个导出请求按侧别补充 RecognitionDeptId、StandardProjectCode；
' 字段由页面按选中汇总行系统填充，汇总请求不携带，用户关键字独立提交。
Person('PlatformAdministrator','平台管理员')
Person('HospitalAdministrator','医院管理员')
UserInterface('RecognitionStatisticsModule','互认统计分析模块')
Enum('RecognitionStatisticsGroupDimensionEnum')[
    统计汇总维度
    --属性--
    医院(Hospital 1)
    院区(Branch 2)
    互认科室(RecognitionDepartment 3)
    标准项目(StandardItem 4)
]
Enum('RecognitionUsageDetailTypeEnum')[
    使用方互认使用明细类型
    --属性--
    提醒(Reminder 1)
    采纳(Adopted 2)
    不采纳(NotAdopted 3)
    引用(Referenced 4)
]
Enum('RecognitionStatisticsExportTypeEnum')[
    互认统计导出类型
    --属性--
    使用方互认使用汇总(RecognitionUsageSummary 1)
    使用方提醒明细(RecognitionReminderDetails 2)
    使用方采纳明细(RecognitionAdoptionDetails 3)
    使用方不采纳明细(RecognitionNonAdoptionDetails 4)
    使用方引用明细(RecognitionReferenceDetails 5)
    提供方医院被互认汇总(SourceRecognitionSummary 6)
    提供方医院被互认明细(SourceRecognitionDetails 7)
]
ReadModel('RecognitionUsageSummaryReadModel')[
    使用方互认使用汇总
    --属性--
    使用方组织编码(ReceiverOrganizationCode String)
    使用方组织名称(ReceiverOrganizationName String)
    使用方医院编码(ReceiverHospitalCode String)
    使用方医院名称(ReceiverHospitalName String)
    使用方院区编码(ReceiverBranchCode String)
    使用方院区名称(ReceiverBranchName String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    项目类型(ItemType MedicalItemType)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    统计开始时间(PeriodStart DateTime)
    统计结束时间(PeriodEnd DateTime)
    采纳次数(AdoptionCount Integer)
    不采纳次数(NonAdoptionCount Integer)
    引用次数(ReferenceCount Integer)
    提醒次数(ReminderCount Integer)
    同期互认率(SamePeriodRecognitionRate Decimal)
    同期互认率已计算(SamePeriodRecognitionRateCalculated Boolean)
    不采纳原因汇总(NonAdoptionReasons NonAdoptionReasonSummaryReadModel 1..*)
    预计节省金额(EstimatedSavingAmount Decimal)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
ReadModel('RecognitionUsageDetailReadModel')[
    使用方互认使用明细
    --属性--
    匹配记录ID(RecognitionMatchRecordId Guid)
    匹配项ID(RecognitionMatchItemId Guid)
    互认匹配生成时间(MatchCreatedTime DateTime)
    本次来源就诊类型(VisitType VisitType)
    本次来源就诊流水号(VisitSerialNo String)
    来源归属(Source SourceOrganizationReadModel)
    接收归属(Receiver ReceiverOrganizationReadModel)
    互认项目(Item RecognitionStatisticsItemReadModel)
    业务时间(BusinessTime DateTime)
    未反馈(IsUnprocessed Boolean)
    患者姓名(PatientName String)
    患者证件号码(IdentityDocumentNo String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    互认医生ID(RecognitionDoctorId String)
    互认医生名称(RecognitionDoctorName String)
    处理事实(ProcessingResult RecognitionProcessingResultDetailReadModel)
    引用事实(Reference RecognitionReferenceDetailReadModel)
]
ReadModel('SourceRecognitionSummaryReadModel')[
    提供方医院被互认汇总
    --属性--
    提供方组织编码(SourceOrganizationCode String)
    提供方组织名称(SourceOrganizationName String)
    提供方医院编码(SourceHospitalCode String)
    提供方医院名称(SourceHospitalName String)
    提供方院区编码(SourceBranchCode String)
    提供方院区名称(SourceBranchName String)
    项目类型(ItemType MedicalItemType)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    统计开始时间(PeriodStart DateTime)
    统计结束时间(PeriodEnd DateTime)
    被互认次数(RecognitionCount Integer)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
ReadModel('SourceRecognitionDetailReadModel')[
    提供方医院被互认明细
    --属性--
    匹配记录ID(RecognitionMatchRecordId Guid)
    匹配项ID(RecognitionMatchItemId Guid)
    提供方组织编码(SourceOrganizationCode String)
    提供方组织名称(SourceOrganizationName String)
    提供方医院编码(SourceHospitalCode String)
    提供方医院名称(SourceHospitalName String)
    提供方院区编码(SourceBranchCode String)
    提供方院区名称(SourceBranchName String)
    使用方组织编码(ReceiverOrganizationCode String)
    使用方组织名称(ReceiverOrganizationName String)
    使用方医院编码(ReceiverHospitalCode String)
    使用方医院名称(ReceiverHospitalName String)
    使用方院区编码(ReceiverBranchCode String)
    使用方院区名称(ReceiverBranchName String)
    标准项目编码(StandardProjectCode String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    互认医生ID(RecognitionDoctorId String)
    互认医生名称(RecognitionDoctorName String)
    互认时间(RecognitionTime DateTime)
    患者姓名(PatientName String)
    患者证件号码(IdentityDocumentNo String)
]
ReadModel('StatisticsExportFileReadModel')[
    统计导出文件
    --属性--
    文件名(FileName String)
    文件格式(FileFormat String)
    文件流(FileStream ByteArray)
]
ReadModel('SourceOrganizationReadModel')[
    提供方组织医院院区
    --属性--
    组织编码(OrganizationCode String)
    组织名称(OrganizationName String)
    医院编码(HospitalCode String)
    医院名称(HospitalName String)
    院区编码(BranchCode String)
    院区名称(BranchName String)
]
ReadModel('ReceiverOrganizationReadModel')[
    使用方组织医院院区
    --属性--
    组织编码(OrganizationCode String)
    组织名称(OrganizationName String)
    医院编码(HospitalCode String)
    医院名称(HospitalName String)
    院区编码(BranchCode String)
    院区名称(BranchName String)
]
ReadModel('RecognitionStatisticsItemReadModel')[
    统计互认项目
    --属性--
    项目类型(ItemType MedicalItemType)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
]
ReadModel('RecognitionProcessingResultDetailReadModel')[
    互认处理结果明细
    --属性--
    是否已反馈(IsProcessed Boolean)
    互认时间(RecognitionTime DateTime)
    处理结果(Decision RecognitionResultEnum)
    不采纳原因代码(NonAdoptionReasonCode String)
    不采纳原因名称(NonAdoptionReasonName String)
    不采纳补充说明(NonAdoptionSupplementDescription String)
