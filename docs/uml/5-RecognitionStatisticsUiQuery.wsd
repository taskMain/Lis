@startuml RecognitionStatisticsUiQuery
!include ddd_lib.puml
' 管理端统计与导出查询；统计事实来自唯一 MedicalRecognitionReportAggregate。
' MedicalItemType 和 VisitType 只引用 1-MedicalRecognitionReport.wsd 的全局正式定义。
Person('PlatformAdministrator','平台管理员')
Person('HospitalAdministrator','医院管理员')
UserInterface('RecognitionStatisticsModule','互认统计分析模块')
Enum('RecognitionStatisticsGroupDimensionEnum')[
    统计汇总维度
    --属性--
    医院(Hospital 1)
    院区(Branch 2)
    互认科室(RecognitionDepartment 3)
    标准项目(StandardItem 4)
]
Enum('RecognitionUsageDetailTypeEnum')[
    接收侧互认使用明细类型
    --属性--
    提醒(Reminder 1)
    采纳(Adopted 2)
    不采纳(NotAdopted 3)
    引用(Referenced 4)
]
Enum('RecognitionStatisticsExportTypeEnum')[
    互认统计导出类型
    --属性--
    接收侧互认使用汇总(RecognitionUsageSummary 1)
    接收侧提醒明细(RecognitionReminderDetails 2)
    接收侧采纳明细(RecognitionAdoptionDetails 3)
    接收侧不采纳明细(RecognitionNonAdoptionDetails 4)
    接收侧引用明细(RecognitionReferenceDetails 5)
    来源医院被互认汇总(SourceRecognitionSummary 6)
    来源医院被互认明细(SourceRecognitionDetails 7)
]
ReadModel('RecognitionUsageSummaryReadModel')[
    接收侧互认使用汇总
    --属性--
    接收组织编码(ReceiverOrganizationCode String)
    接收组织名称(ReceiverOrganizationName String)
    接收医院编码(ReceiverHospitalCode String)
    接收医院名称(ReceiverHospitalName String)
    接收院区编码(ReceiverBranchCode String)
    接收院区名称(ReceiverBranchName String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    项目类型(ItemType MedicalItemType)
    标准项目编码(StandardProjectCode String)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    统计开始时间(PeriodStart DateTime)
    统计结束时间(PeriodEnd DateTime)
    采纳次数(AdoptionCount Integer)
    不采纳次数(NonAdoptionCount Integer)
    引用次数(ReferenceCount Integer)
    提醒次数(ReminderCount Integer)
    同期互认率(SamePeriodRecognitionRate Decimal)
    同期互认率已计算(SamePeriodRecognitionRateCalculated Boolean)
    不采纳原因汇总(NonAdoptionReasons NonAdoptionReasonSummaryReadModel)
    预计节省金额(EstimatedSavingAmount Decimal)
]
ReadModel('RecognitionUsageDetailReadModel')[
    接收侧互认使用明细
    --属性--
    匹配记录ID(RecognitionMatchRecordId Guid)
    匹配项ID(RecognitionMatchItemId Guid)
    互认匹配生成时间(MatchCreatedTime DateTime)
    本次来源就诊类型(VisitType VisitType)
    本次来源就诊流水号(VisitSerialNo String)
    来源归属(Source SourceOrganizationReadModel)
    接收归属(Receiver ReceiverOrganizationReadModel)
    互认项目(Item RecognitionStatisticsItemReadModel)
    业务时间(BusinessTime DateTime)
    未反馈(IsUnprocessed Boolean)
    患者姓名(PatientName String)
    患者证件号码(IdentityDocumentNo String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    互认医生ID(RecognitionDoctorId String)
    互认医生名称(RecognitionDoctorName String)
    处理事实(ProcessingResult RecognitionProcessingResultDetailReadModel)
    引用事实(Reference RecognitionReferenceDetailReadModel)
]
ReadModel('SourceRecognitionSummaryReadModel')[
    来源医院被互认汇总
    --属性--
    来源组织编码(SourceOrganizationCode String)
    来源组织名称(SourceOrganizationName String)
    来源医院编码(SourceHospitalCode String)
    来源医院名称(SourceHospitalName String)
    来源院区编码(SourceBranchCode String)
    来源院区名称(SourceBranchName String)
    项目类型(ItemType MedicalItemType)
    标准项目编码(StandardProjectCode String)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    统计开始时间(PeriodStart DateTime)
    统计结束时间(PeriodEnd DateTime)
    被互认次数(RecognitionCount Integer)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
ReadModel('SourceRecognitionDetailReadModel')[
    来源医院被互认明细
    --属性--
    匹配记录ID(RecognitionMatchRecordId Guid)
    匹配项ID(RecognitionMatchItemId Guid)
    来源组织编码(SourceOrganizationCode String)
    来源组织名称(SourceOrganizationName String)
    来源医院编码(SourceHospitalCode String)
    来源医院名称(SourceHospitalName String)
    来源院区编码(SourceBranchCode String)
    来源院区名称(SourceBranchName String)
    接收组织编码(ReceiverOrganizationCode String)
    接收组织名称(ReceiverOrganizationName String)
    接收医院编码(ReceiverHospitalCode String)
    接收医院名称(ReceiverHospitalName String)
    接收院区编码(ReceiverBranchCode String)
    接收院区名称(ReceiverBranchName String)
    标准项目编码(StandardProjectCode String)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    互认医生ID(RecognitionDoctorId String)
    互认医生名称(RecognitionDoctorName String)
    互认时间(RecognitionTime DateTime)
    患者姓名(PatientName String)
    患者证件号码(IdentityDocumentNo String)
]
ReadModel('StatisticsExportFileReadModel')[
    统计导出文件
    --属性--
    文件名(FileName String)
    文件格式(FileFormat String)
    文件流(FileStream ByteArray)
]
ReadModel('SourceOrganizationReadModel')[
    来源组织医院院区
    --属性--
    组织编码(OrganizationCode String)
    组织名称(OrganizationName String)
    医院编码(HospitalCode String)
    医院名称(HospitalName String)
    院区编码(BranchCode String)
    院区名称(BranchName String)
]
ReadModel('ReceiverOrganizationReadModel')[
    接收组织医院院区
    --属性--
    组织编码(OrganizationCode String)
    组织名称(OrganizationName String)
    医院编码(HospitalCode String)
    医院名称(HospitalName String)
    院区编码(BranchCode String)
    院区名称(BranchName String)
]
ReadModel('RecognitionStatisticsItemReadModel')[
    统计互认项目
    --属性--
    项目类型(ItemType MedicalItemType)
    分类名称(CategoryName String)
    分组名称(GroupName String)
    标准项目编码(StandardProjectCode String)
    标准项目名称(StandardProjectName String)
]
ReadModel('RecognitionProcessingResultDetailReadModel')[
    互认处理结果明细
    --属性--
    是否已反馈(IsProcessed Boolean)
    互认时间(RecognitionTime DateTime)
    处理结果(Decision RecognitionResultEnum)
    不采纳原因代码(NonAdoptionReasonCode String)
    不采纳原因名称(NonAdoptionReasonName String)
    不采纳补充说明(NonAdoptionSupplementDescription String)
    预计节省金额(EstimatedSavingAmount Decimal)
]
ReadModel('NonAdoptionReasonSummaryReadModel')[
    不采纳原因汇总项
    --属性--
    原因代码(ReasonCode String)
    原因名称(ReasonName String)
    次数(Count Integer)
    占比(Ratio Decimal)
]
ReadModel('RecognitionMatchRecordReadModel')[
    互认匹配记录集合视图
    --属性--
    互认匹配记录ID(RecognitionMatchRecordId Guid)
    互认匹配生成时间(MatchCreatedTime DateTime)
    接收归属(Receiver ReceiverOrganizationReadModel)
    患者姓名(PatientName String)
    患者证件号码(IdentityDocumentNo String)
    本次来源就诊类型(VisitType VisitType)
    本次来源就诊流水号(VisitSerialNo String)
    是否已反馈(IsProcessed Boolean)
    互认时间(RecognitionTime DateTime)
    互认科室ID(RecognitionDeptId String)
    互认科室名称(RecognitionDeptName String)
    互认医生ID(RecognitionDoctorId String)
    互认医生名称(RecognitionDoctorName String)
    匹配项目集合(MatchItems RecognitionMatchRecordItemReadModel)
]
ReadModel('RecognitionMatchRecordItemReadModel')[
    互认匹配记录项目
    --属性--
    互认匹配项ID(RecognitionMatchItemId Guid)
    互认项目(Item RecognitionStatisticsItemReadModel)
    来源归属(Source SourceOrganizationReadModel)
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    是否已反馈(IsProcessed Boolean)
    处理结果(Decision RecognitionResultEnum)
    不采纳原因代码(NonAdoptionReasonCode String)
    不采纳原因名称(NonAdoptionReasonName String)
]
ReadModel('RecognitionReferenceDetailReadModel')[
    引用事实明细
    --属性--
    是否已引用(IsReferenced Boolean)
    实际引用时间(ReferenceTime DateTime)
    引用科室ID(ReferenceDeptId String)
    引用科室名称(ReferenceDeptName String)
    引用医生ID(ReferenceDoctorId String)
    引用医生名称(ReferenceDoctorName String)
]
Query('QueryRecognitionUsageSummary')[
    查询接收侧互认使用汇总
    --入参--
    开始时间(StartTime DateTime)
    结束时间(EndTime DateTime)
    组织编码(OrganizationCode String?)
    医院编码(HospitalCode String?)
    院区编码(BranchCode String?)
    来源组织编码(SourceOrganizationCode String?)
    来源医院编码(SourceHospitalCode String?)
    来源院区编码(SourceBranchCode String?)
    互认科室ID(RecognitionDeptId String?)
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
    分组名称(GroupName String?)
    标准项目编码(StandardProjectCode String?)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
Query('QueryRecognitionUsageDetails')[
    查询接收侧互认使用明细
    --入参--
    开始时间(StartTime DateTime)
    结束时间(EndTime DateTime)
    组织编码(OrganizationCode String?)
    医院编码(HospitalCode String?)
    院区编码(BranchCode String?)
    来源组织编码(SourceOrganizationCode String?)
    来源医院编码(SourceHospitalCode String?)
    来源院区编码(SourceBranchCode String?)
    互认科室ID(RecognitionDeptId String?)
    互认医生ID(RecognitionDoctorId String?)
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
    分组名称(GroupName String?)
    标准项目编码(StandardProjectCode String?)
    不采纳原因代码(NonAdoptionReasonCode String?)
    明细类型(DetailType RecognitionUsageDetailTypeEnum)
]
Query('QuerySourceRecognitionSummary')[
    查询来源医院被互认汇总
    --入参--
    开始时间(StartTime DateTime)
    结束时间(EndTime DateTime)
    来源组织编码(SourceOrganizationCode String?)
    来源医院编码(SourceHospitalCode String?)
    来源院区编码(SourceBranchCode String?)
    接收组织编码(ReceiverOrganizationCode String?)
    接收医院编码(ReceiverHospitalCode String?)
    接收院区编码(ReceiverBranchCode String?)
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
    分组名称(GroupName String?)
    标准项目编码(StandardProjectCode String?)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
Query('QuerySourceRecognitionDetails')[
    查询来源医院被互认明细
    --入参--
    开始时间(StartTime DateTime)
    结束时间(EndTime DateTime)
    来源组织编码(SourceOrganizationCode String?)
    来源医院编码(SourceHospitalCode String?)
    来源院区编码(SourceBranchCode String?)
    接收组织编码(ReceiverOrganizationCode String?)
    接收医院编码(ReceiverHospitalCode String?)
    接收院区编码(ReceiverBranchCode String?)
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
    分组名称(GroupName String?)
    标准项目编码(StandardProjectCode String?)
]
note right of QuerySourceRecognitionDetails
  来源医院被互认明细只反映被采纳事实，不适用不采纳原因代码筛选。
  统计导出的不采纳原因代码仅适用于接收侧不采纳明细。
end note
Query('GetRecognitionStatisticsExport')[
    获取互认统计导出
    --入参--
    导出类型(ExportType RecognitionStatisticsExportTypeEnum)
    开始时间(StartTime DateTime)
    结束时间(EndTime DateTime)
    组织编码(OrganizationCode String?)
    医院编码(HospitalCode String?)
    院区编码(BranchCode String?)
    来源组织编码(SourceOrganizationCode String?)
    来源医院编码(SourceHospitalCode String?)
    来源院区编码(SourceBranchCode String?)
    接收组织编码(ReceiverOrganizationCode String?)
    接收医院编码(ReceiverHospitalCode String?)
    接收院区编码(ReceiverBranchCode String?)
    互认科室ID(RecognitionDeptId String?)
    互认医生ID(RecognitionDoctorId String?)
    项目类型(ItemType MedicalItemType?)
    分类名称(CategoryName String?)
    分组名称(GroupName String?)
    标准项目编码(StandardProjectCode String?)
    不采纳原因代码(NonAdoptionReasonCode String?)
    汇总维度(GroupDimension RecognitionStatisticsGroupDimensionEnum)
]
Query('GetRecognitionMatchRecord')[
    查看互认匹配记录
    --入参--
    互认匹配记录ID(RecognitionMatchRecordId Guid)
]
note right of RecognitionUsageSummaryReadModel
  统计仅覆盖当前组织内事实；来源组织与接收组织必须一致。
  接收侧汇总仅支持医院、院区、互认科室、标准项目维度；来源侧汇总仅支持来源医院、来源院区、标准项目维度。
  提醒按非空匹配记录生成时间统计；采纳/不采纳/金额按互认时间统计；引用按实际引用时间统计。
  未反馈匹配项进入提醒明细，IsUnprocessed=true，不推断为不采纳。
  同期互认率分母为同期提醒次数；提醒为零时 Calculated=false，数值无业务含义。
  不采纳原因按平台原因代码汇总。
  互认科室按院区+科室ID归类，展示当前范围内互认时间最晚处理结果保存的名称。
  导出继承页面查询条件、汇总维度、既有业务范围和患者信息口径（MVP 不实现脱敏，患者姓名与证件号码按业务原值）；当前条件下无记录时不生成文件、不扩大查询范围。本模块不重复判断操作权限。
end note
PlatformAdministrator --> RecognitionStatisticsModule
HospitalAdministrator --> RecognitionStatisticsModule
RecognitionStatisticsModule --> QueryRecognitionUsageSummary
RecognitionStatisticsModule --> QueryRecognitionUsageDetails
RecognitionStatisticsModule --> QuerySourceRecognitionSummary
RecognitionStatisticsModule --> QuerySourceRecognitionDetails
RecognitionStatisticsModule --> GetRecognitionStatisticsExport
RecognitionStatisticsModule --> GetRecognitionMatchRecord
QueryRecognitionUsageSummary .. RecognitionUsageSummaryReadModel
QueryRecognitionUsageDetails .. RecognitionUsageDetailReadModel
QuerySourceRecognitionSummary .. SourceRecognitionSummaryReadModel
QuerySourceRecognitionDetails .. SourceRecognitionDetailReadModel
GetRecognitionStatisticsExport .. StatisticsExportFileReadModel
GetRecognitionMatchRecord .. RecognitionMatchRecordReadModel
@enduml
