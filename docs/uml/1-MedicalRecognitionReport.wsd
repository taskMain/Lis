]

Entity('ExaminationReportContentEntity')[
    检查报告专项内容
    --属性--
    ID(Id Guid)
    报告版本ID(ReportVersionId Guid)
    来源检查类型编码(SourceExaminationTypeCode String?)
    来源检查类型名称(SourceExaminationTypeName String?)
    报告备注(ReportRemark Text?)
    检查所见(Findings Text)
    检查结论(Conclusion Text)
    整体异常标识(OverallAbnormalFlag String?)
    来源临床诊断编码(SourceDiagnosisCode String?)
    来源临床诊断名称(SourceDiagnosisName String)
    病情描述(ConditionDescription Text?)
    检查目的(ExaminationPurpose Text?)
    实际检查时间(ExaminationTime DateTime)
    检查方法(ExaminationMethod String?)
    设备编号(DeviceCode String?)
    设备名称(DeviceName String?)
    检查医生ID(ExaminerId Guid)
    检查医生名称(ExaminerName String)
    来源影像状态(SourceImageStatus SourceImageStatus)
    影像调阅地址(ImageAccessUrl String?)
    --规则--
    1.影像地址按医院提交的外部 HTTPS 地址原样保存，平台不测试、代理、缓存或保证可用性，不接收 DICOM
]

Entity('ExaminationItemEntity')[
    检查项目
    --属性--
    ID(Id Guid)
    报告版本ID(ReportVersionId Guid)
    院内项目编码(HospitalItemCode String)
    院内项目名称(HospitalItemName String)
