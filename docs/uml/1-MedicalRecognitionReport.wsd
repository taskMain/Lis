    院内标本号(SourceSpecimenNo String)
    标本类型编码(SpecimenTypeCode String)
    标本类型名称(SpecimenTypeName String)
    标本采集时间(SpecimenCollectedTime DateTime?)
    标本送检时间(SpecimenSubmittedTime DateTime?)
    检验科接收时间(LaboratoryReceivedTime DateTime?)
    检测完成时间(TestingCompletedTime DateTime)
    检验人ID(InspectorId Guid)
    检验人名称(InspectorName String)
]

Entity('LaboratoryResultItemEntity')[
