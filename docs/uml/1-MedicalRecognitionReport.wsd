    ID(Id Guid)
    检查项目ID(ExaminationItemId Guid)
    来源部位编码(SourceSiteCode String?)
    部位名称(SiteName String)
]

Entity('RecognitionCandidateProviderGroupEntity')[
    候选提供组
    --属性--
    ID(Id Guid)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    证件类型代码(IdentityDocumentTypeCode String)
    证件号码(IdentityDocumentNo String)
    本次就诊类型(CurrentVisitType VisitType)
    本次院内就诊流水号(CurrentVisitSerialNo String)
    提供时间(ProvidedTime DateTime)
    互认时间(RecognitionTime DateTime?)
    决定科室ID(DecisionDeptId Guid?)
    决定科室名称(DecisionDeptName String?)
    决定医生ID(DecisionDoctorId Guid?)
    决定医生名称(DecisionDoctorName String?)
    决定首次保存时间(DecisionSavedTime DateTime?)
    --规则--
    1.仅非空候选生成提供组，每次查询使用新 ID；组生成本身形成提醒事实，响应超时不删除且重试不恢复旧组
    2.决定首次成功保存时间是本组引用详情有效期的独立起点，幂等重试不刷新
]

Entity('RecognitionCandidateItemEntity')[
    候选项目
    --属性--
    ID(Id Guid)
    候选提供组ID(CandidateProviderGroupId Guid)
    本次拟开院内项目类型(ItemType MedicalReportType)
    本次拟开院内项目编码(BranchMedicalItemCode String)
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    互认项目编码(RecognitionItemCode String)
    互认项目名称(RecognitionItemName String)
    --规则--
    1.候选项目只属于一次候选提供组，并保存本次拟开院内项目、当时的报告版本和互认项目快照
]

Entity('RecognitionDecisionEntity')[
    互认决定
    --属性--
    ID(Id Guid)
    候选提供组ID(CandidateProviderGroupId Guid)
    候选项目ID(CandidateItemId Guid)
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    互认项目编码(RecognitionItemCode String)
    决定结果(DecisionResult RecognitionDecisionResult)
    不采纳原因(NonAdoptionReason RecognitionNonAdoptionReason?)
    不采纳补充说明(NonAdoptionDescription Text?)
    预计节省金额(EstimatedSavingAmount Decimal(18,2)?)
    --规则--
    1.候选提供组和候选项目构成业务唯一键，决定必须恰好覆盖组内全部项目并整批原子保存
    2.首次成功保存后不可更正、撤销、删除或覆盖；相同完整组请求幂等，不同内容冲突
    3.引用详情使用全平台统一的正整数分钟参数，默认 720 分钟，并从组级首次成功时间起算
]

Entity('RecognitionReferenceEntity')[
    互认引用事实
    --属性--
    ID(Id Guid)
    候选提供组ID(CandidateProviderGroupId Guid)
    候选项目ID(CandidateItemId Guid)
    报告ID(ReportId Guid)
    报告版本ID(ReportVersionId Guid)
    互认项目编码(RecognitionItemCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    本次就诊类型(CurrentVisitType VisitType)
    本次院内就诊流水号(CurrentVisitSerialNo String)
    实际引用时间(ReferencedTime DateTime)
    引用科室ID(ReferenceDeptId Guid)
    引用科室名称(ReferenceDeptName String)
    引用医生ID(ReferenceDoctorId Guid)
    引用医生名称(ReferenceDoctorName String)
    --规则--
    1.候选提供组和候选项目构成业务唯一键，只允许记录组内已采纳且实际写入病历的项目
    2.每次数组整批原子保存；单个候选项目的首次引用事实不可更正、撤销、删除或覆盖
    3.提交不设期限，报告后来失效也不拒绝既有引用事实的明确反馈
]

