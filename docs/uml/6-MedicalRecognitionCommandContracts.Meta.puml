    ReferenceDoctorName : String
}
class "互认引用结果提交请求" as RecognitionReferenceSubmitRequest <<Request>> {
    Items : RecognitionReferenceItemRequest[]
}
note right of RecognitionReferenceSubmitRequest
    不提交 RecognitionMatchRecordId。
    每个 RecognitionMatchItemId 全局唯一，平台据此反查所属匹配记录和已保存采纳结果。
    同一请求允许混合不同匹配记录的项目，但整批校验并原子保存。
end note
class "互认处理结果事实" as RecognitionProcessingResultFact <<EventContract>> {
    RecognitionMatchItemId : Guid
    RecognitionResult : RecognitionResult
    EstimatedSavingAmount : Decimal(18,2)?
}
note right of RecognitionProcessingResultFact
    EstimatedSavingAmount 是平台形成的采纳事实，不是请求输入。
    同一请求幂等重试及后续金额调整均不重新计算。
end note
class "互认引用事实" as RecognitionReferenceFact <<EventContract>> {
    RecognitionMatchItemId : Guid
    ReferencedTime : DateTime
}
