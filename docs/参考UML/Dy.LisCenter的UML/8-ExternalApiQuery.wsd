ReadModel('ReceiverSpecimenReadModel')[
    接收方样本
    --属性--
    样本条码(SpecimenBarcode String)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    发起方申请单号(InitiatorApplicationNo String?)
    患者信息摘要(PatientSummary PatientSummaryReadModel)
    就诊信息摘要(VisitSummary VisitSummaryReadModel)
    样本信息摘要(SpecimenSummary SpecimenSummaryReadModel)
    项目清单摘要(ProjectSummary ProjectSummaryReadModel[])
    是否绿色通道(IsGreenChannel Boolean)
    包编码(PackageCode String)
    样本级送出时间(DispatchTime DateTime)
    是否补录(IsSupplemented Boolean)
    接收状态(ReceiptStatus ReceiptStatus)
    样本当前处理展示状态(CurrentProcessingStatus CurrentProcessingStatus)
    当前处理状态来源(CurrentProcessingStatusSource String?)
    最近处理时间(LastProcessingTime DateTime?)
    接收处理结果(ReceiptResult ReceiptResult?)
    接收时间(ReceiptTime DateTime?)
    接收科室编码(ReceiverDeptCode String?)
    接收科室名称(ReceiverDeptName String?)
    条码备注(BarcodeRemark String?)
    备注(Remark String?)
    --规则--
    1.接收科室字段仅来源于接收记录快照，待接收或无接收记录时为空
]

ReadModel('ReceiverPackageSpecimenReadModel')[
