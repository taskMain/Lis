    接收方有效项目对照数量(ReceiverEffectiveMappingCount Integer)
    是否可申请(IsAvailable Boolean)
    目录诊断状态(Status ExternalApplicationItemCatalogStatus)
]

Query('QueryApplicationItemCatalog')[
    查询可申请项目目录接口
    --入参--
    接收医院编码(ReceiverHospitalCode String?)
    接收院区编码(ReceiverBranchCode String?)
    关键字(Keyword String?)
    发起院区项目编码集合(InitiatorItemCodes String[]?)
    --规则--
    1.当前发起医院和发起院区从可信 Token 获取
    2.仅查询当前启用协作关系
    3.只有发起方项目对照唯一启用、院区可承接项目配置启用并实际可用时可申请
    4.未传发起院区项目编码集合时只返回实际可用项目
    5.传入明确发起院区项目编码集合时保留配置诊断，区分未配置、已停用、接收方项目对照异常和标准医疗项目失效
    6.创建申请使用返回的发起院区项目编码，不提交标准或接收院区项目编码，并由服务端重新校验整单全部项目
]
InitiatorExternalSystem --> QueryApplicationItemCatalog
QueryApplicationItemCatalog .. ExternalApplicationItemCatalogReadModel

Query('QueryInitiatorPackageList')[
    发起方查询包列表接口
    --入参--
    接收医院编码(ReceiverHospitalCode String?)
    接收院区编码(ReceiverBranchCode String?)
    包编码(PackageCode String?)
    包名称(PackageName String?)
    样本条码(SpecimenBarcode String?)
    包状态(Status SpecimenPackageStatus?)
    包交接状态(PackageHandoverStatus PackageHandoverStatus?)
    送出时间起(DispatchTimeFrom DateTime?)
    送出时间止(DispatchTimeTo DateTime?)
]
InitiatorExternalSystem --> QueryInitiatorPackageList
QueryInitiatorPackageList .. PackageSummaryReadModel

Query('QueryReceiverPackageList')[
    接收方查询包列表接口
    --入参--
    发起医院编码(InitiatorHospitalCode String?)
    发起院区编码(InitiatorBranchCode String?)
    包编码(PackageCode String?)
    包名称(PackageName String?)
    样本条码(SpecimenBarcode String?)
    包状态(Status SpecimenPackageStatus?)
    包交接状态(PackageHandoverStatus PackageHandoverStatus?)
    送出时间起(DispatchTimeFrom DateTime?)
    送出时间止(DispatchTimeTo DateTime?)
]
ReceiverExternalSystem --> QueryReceiverPackageList
QueryReceiverPackageList .. PackageSummaryReadModel

Query('QueryInitiatorPackageDetail')[
    发起方查询包详情接口
    --入参--
    包编码(PackageCode String)
]
InitiatorExternalSystem --> QueryInitiatorPackageDetail
QueryInitiatorPackageDetail .. InitiatorPackageDetailReadModel

Query('QueryReceiverPackageDetail')[
    接收方查询包详情接口
    --入参--
    包编码(PackageCode String)
]
ReceiverExternalSystem --> QueryReceiverPackageDetail
QueryReceiverPackageDetail .. ReceiverPackageDetailReadModel

Query('QueryReceiverSpecimenList')[
    查询接收方样本清单接口
    --入参--
    接收状态(ReceiptStatus ReceiptStatus?)
    发起医院编码(InitiatorHospitalCode String?)
    发起院区编码(InitiatorBranchCode String?)
    送出时间起(DispatchTimeFrom DateTime?)
    送出时间止(DispatchTimeTo DateTime?)
    接收时间起(ReceiptTimeFrom DateTime?)
    接收时间止(ReceiptTimeTo DateTime?)
    --规则--
    1.送出时间范围按当前有效 DispatchSpecimen.DispatchTime 过滤
]
ReceiverExternalSystem --> QueryReceiverSpecimenList
QueryReceiverSpecimenList .. ReceiverSpecimenReadModel

Query('QueryReceiverSpecimenDetail')[
    查询接收方单个样本接口
    --入参--
    样本条码(SpecimenBarcode String)
    --规则--
    1.返回的 DispatchTime 为样本级送出时间，来源于当前有效 DispatchSpecimen.DispatchTime
]
ReceiverExternalSystem --> QueryReceiverSpecimenDetail
QueryReceiverSpecimenDetail .. ReceiverSpecimenReadModel

Query('QueryCurrentLabReportInfo')[
    获取当前有效报告信息接口
    --入参--
    平台申请单号(ApplicationNo String)
    样本条码(SpecimenBarcode String)
    --规则--
    1.发起医院、发起院区从可信 Token 获取
]
InitiatorExternalSystem --> QueryCurrentLabReportInfo
QueryCurrentLabReportInfo .. CurrentLabReportReadModel

' I04-22 由 ExternalReportFileController 的 DownloadCurrent 传输端点处理，不属于 ExternalQueryAppService 查询模型。

Query('QueryInitiatorSpecimenLifecycleDetail')[
    发起方查询样本生命周期详情接口
    --入参--
    平台申请单号(ApplicationNo String)
    样本条码(SpecimenBarcode String)
    --规则--
    1.发起医院、发起院区从可信 Token 获取
]
InitiatorExternalSystem --> QueryInitiatorSpecimenLifecycleDetail
QueryInitiatorSpecimenLifecycleDetail .. InitiatorSpecimenLifecycleDetailReadModel

Query('QueryReceiverSpecimenLifecycleDetail')[
    接收方查询样本生命周期详情接口
    --入参--
    平台申请单号(ApplicationNo String)
    样本条码(SpecimenBarcode String)
    --规则--
    1.接收医院、接收院区从可信 Token 获取
]
ReceiverExternalSystem --> QueryReceiverSpecimenLifecycleDetail
QueryReceiverSpecimenLifecycleDetail .. ReceiverSideSpecimenLifecycleDetailReadModel

' 建模口径：Query .. ReadModel 表示查询主返回读模型；Query .. Aggregate 表示查询来源/业务归属聚合引用，不计入主 ReadModel 数量。
Aggregate('ApplicationAggregate','申请单生命周期聚合')
Aggregate('BranchCollaborationAggregate','院区协作关系聚合')
Aggregate('BranchLabItemMappingAggregate','院区项目对照聚合')
Aggregate('ReceiverBranchLabItemCapabilityAggregate','院区可承接项目聚合')

QueryApplicationItemCatalog .. BranchCollaborationAggregate
QueryApplicationItemCatalog .. BranchLabItemMappingAggregate
QueryApplicationItemCatalog .. ReceiverBranchLabItemCapabilityAggregate
QueryInitiatorPackageList .. ApplicationAggregate
QueryReceiverPackageList .. ApplicationAggregate
QueryInitiatorPackageDetail .. ApplicationAggregate
QueryReceiverPackageDetail .. ApplicationAggregate
QueryReceiverSpecimenList .. ApplicationAggregate
QueryReceiverSpecimenDetail .. ApplicationAggregate
QueryCurrentLabReportInfo .. ApplicationAggregate
QueryInitiatorSpecimenLifecycleDetail .. ApplicationAggregate
QueryReceiverSpecimenLifecycleDetail .. ApplicationAggregate

@enduml
