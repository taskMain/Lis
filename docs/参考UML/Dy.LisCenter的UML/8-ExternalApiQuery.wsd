' 查询图：对外 JSON 查询由 ExternalQueryAppService 自动路由 `/Api/ExternalQuery/{Method}` 承载；
' 仅经过 External Request -> 查询仓储/读模型 -> External 白名单 DTO，不建立查询命令或领域事件。
' PDF 上传、下载是 ExternalReportFileController 的传输特例：/Api/ExternalReportFile/Upload、/DownloadCurrent。
@startuml ExternalApiQuery
!include ddd_lib.puml

' T03 对外查询字段来源口径：当前申请编号来自申请单当前主数据，当前样本条码来自样本当前主数据；
' 包清单、送出、接收和异常历史结果中的业务编号来自对应事实形成时的逐样本快照。
' External 完整集合和详情继续逐样本返回真实归属，包级记录头不得伪造单一申请归属。

Person('InitiatorExternalSystem','发起方侧外部接入系统')
Person('ReceiverExternalSystem','接收方侧外部接入系统')

Enum('SpecimenPackageStatusEnum')[
    包状态
    --属性--
    有效(Valid 1)
    已作废(Voided 2)
]

Enum('PackageHandoverStatusEnum')[
    包交接状态
    --属性--
    未送出(PendingDispatch 1)
    已送出(Dispatched 2)
    已接收(Received 3)
]

Enum('PackageAdjustActionEnum')[
    包内样本调整动作
    --属性--
    加入样本(AddSpecimen 1)
    移出样本(RemoveSpecimen 2)
]

Enum('PackageSpecimenSupplementReasonEnum')[
    已送出包样本补录原因
    --属性--
    线下包内实物多于系统清单(PhysicalPackageExtraSpecimen 1)
    系统漏登记(SystemOmission 2)
    其他(Other 3)
]

Enum('SpecimenPackageVoidReasonEnum')[
    样本包作废原因
    --属性--
    样本信息错误(SpecimenInfoError 1)
    包内容变更(PackageContentChanged 2)
    不再需要送出(NoLongerNeedDispatch 3)
    其他(Other 4)
]

Enum('ReceiptStatusEnum')[
    接收状态
    --属性--
    待接收(PendingReceipt 1)
    已接收(Received 2)
]

Enum('ReceiptResultEnum')[
    接收处理结果
    --属性--
    正常接收(Normal 1)
    异常接收(Exceptional 2)
    未到货(NotArrived 3)
]

Enum('BarcodeStatusEnum')[
    样本有效状态
    --属性--
    有效(Valid 1)
    已结束(Ended 2)
]

Enum('BarcodeEndTypeEnum')[
    结束类型
    --属性--
    发起方终止(InitiatorTerminated 1)
    样本无法继续检测(UnprocessableSpecimen 2)
]

Enum('SpecimenMainStatusEnum')[
    样本主状态
    --属性--
    待送出(PendingDispatch 1)
    已送出(Dispatched 2)
    已接收(Received 3)
    检测中(Testing 4)
    检测完成(Completed 5)
]

Enum('VisitTypeEnum')[
    就诊类型
    --属性--
    门诊(Outpatient 1)
    住院(Inpatient 2)
    体检(PhysicalExam 3)
    急诊(Emergency 4)
    其他(Other 5)
    未知(Unknown 6)
]

Enum('FinalReceiptConclusionEnum')[
    最终接收结论
    --属性--
    正常接收(NormalReceipt 1)
    异常接收(ExceptionalReceipt 2)
]

Enum('CurrentProcessingStatusEnum')[
    样本当前处理展示状态
    --属性--
    待接收(PendingReceipt 1)
    未到货待处理(NotArrivedPending 2)
    已撤回(Withdrawn 3)
    已拦截(Intercepted 4)
    异常已归档(ExceptionArchived 5)
    运输丢失导致样本结束(TransportLostEnded 6)
]

Enum('FeeStatusEnum')[
    费用状态
    --属性--
    已收费(Charged 1)
    未收费(Uncharged 2)
    无需收费(NoChargeRequired 3)
    未知(Unknown 4)
]

Enum('ReceiverMappingStatusEnum')[
    接收方项目对照状态
    --属性--
    已匹配(Matched 1)
    未匹配(Unmatched 2)
]

Enum('ExternalApplicationItemCatalogStatusEnum')[
    外部创建申请项目目录状态
    --属性--
    可申请(Available 1)
    发起方项目未配置对照(InitiatorMappingMissing 2)
    发起方项目对照已停用(InitiatorMappingDisabled 3)
    标准医疗项目不可用(StandardItemUnavailable 4)
    发起方项目对照重复(InitiatorMappingAmbiguous 5)
    接收方项目未配置对照(ReceiverMappingMissing 6)
    接收方项目对照已停用或不可用(ReceiverMappingDisabled 7)
    接收方项目对照重复(ReceiverMappingAmbiguous 8)
    接收方项目对照配置异常(ReceiverMappingInvalid 9)
    接收院区可承接项目未配置(ReceiverCapabilityMissing 10)
    接收院区可承接项目已停用(ReceiverCapabilityDisabled 11)
]

Enum('LabReportStatusEnum')[
    报告状态
    --属性--
    已发布(Published 1)
    已作废(Voided 2)
]

Enum('NoCurrentReportReasonEnum')[
    无当前有效报告原因
    --属性--
    从未上传(NeverUploaded 1)
    当前报告已作废(CurrentReportVoided 2)
    样本已结束无有效报告(SpecimenEndedNoEffectiveReport 3)
    不可查询(NotQueryable 4)
]

Enum('LabReportVoidReasonEnum')[
    报告作废原因
    --属性--
    报告错误(ReportError 1)
    重复报告(DuplicateReport 2)
    本报告不应发布(ShouldNotBePublished 3)
    其他(Other 4)
]

Enum('LabResultTypeEnum')[
    报告结果类型
    --属性--
    数值(Numeric 1)
    定性(Qualitative 2)
    文本(Text 3)
]

Enum('PackageParticipantRoleEnum')[
    包与我方关系
    --属性--
    发起方(Initiator 1)
    接收方(Receiver 2)
]

ReadModel('PackageSummaryReadModel')[
    包摘要
    --属性--
    包编码(PackageCode String)
    包名称(PackageName String?)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    包与我方关系(PackageParticipantRole PackageParticipantRole?)
    包状态(Status SpecimenPackageStatus)
    包交接状态(PackageHandoverStatus PackageHandoverStatus)
    送出时间(DispatchTime DateTime?)
    包接收时间(PackageReceiveTime DateTime?)
    包内样本数量(SpecimenCount Integer)
    作废原因(VoidReason SpecimenPackageVoidReason?)
    作废说明(VoidDescription String?)
    作废时间(VoidedTime DateTime?)
]

ReadModel('InitiatorPackageDetailReadModel')[
