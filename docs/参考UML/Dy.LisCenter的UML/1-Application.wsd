'============================================= 样本终止 =============================================
FacadeCommand('TerminateSpecimenCommand')[
    终止样本
    --入参--
    平台申请单号(ApplicationNo String)
    样本条码(SpecimenBarcode String)
    终止原因(TerminationReason BarcodeTerminationReason)
    终止说明(TerminationDescription String?)
    终止时间(TerminationTime DateTime)
    --规则--
    1.仅未接收前允许终止，样本已接收、检测中、检测完成或已有报告时拒绝
    2.终止类型由当前样本主状态推导
    3.未到货异常待处理时，同一事务关闭未到货异常
    4.终止后 BarcodeStatus=Ended，按有效样本集合重算 ApplicationState；全部有效样本结束时 ApplicationState=Closed
]
DomainEvent('SpecimenTerminatedEvent')[
    样本已终止
    --属性--
    申请单ID(ApplicationId Guid)
    样本ID(SpecimenId Guid)
