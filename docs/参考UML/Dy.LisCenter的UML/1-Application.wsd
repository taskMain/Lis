    发起院区编码(InitiatorBranchCode String)
    发起科室ID(InitiatorDeptId Guid?)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    样本条码(SpecimenBarcode String)
    终止类型(TerminationType BarcodeTerminationType)
    终止原因(TerminationReason BarcodeTerminationReason)
    终止时间(TerminationTime DateTime)
]
InitiatorExternalSystem --> TerminateSpecimenCommand
InitiatorUser --> TerminateSpecimenCommand
TerminateSpecimenCommand ..> SpecimenTerminatedEvent : send

'============================================= 送出与撤回 =============================================
FacadeCommand('CancelSpecimenPackageDispatchCommand')[
    撤销包送出
    --入参--
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    包编码(PackageCode String)
    撤销原因(CancelReason DispatchCancelReason)
    撤销说明(CancelDescription String?)
    撤销时间(CancelTime DateTime)
    操作人(OperId Guid)
    操作时间(OperTime DateTime)
    --规则--
    1.仅用于整包误操作送出但线下实体包未实际发出的纠错
    2.仅允许有效、已送出、未接收且当前有效送出记录状态为 Dispatched 的包撤销
    3.接收方仅扫码或查询包详情不阻断撤销；已有正常接收、异常接收、未到货、检测中、检测完成、报告或条码终止时拒绝
    4.成功后包交接状态回到 PendingDispatch，包编码和包内样本清单保留，可继续调整、作废或重新送出
    5.当前送出记录状态变为 Cancelled，记录撤销原因、说明、实际撤销时间和可信 Token 审计身份；不接收 cancelledBy
    6.原送出样本明细保留快照并标记撤回或撤销，包内样本 SpecimenMainStatus=PendingDispatch，CurrentDispatchRecordId 清空
]
DomainEvent('SpecimenPackageDispatchCancelledEvent')[
    样本包送出已撤销
    --属性--
    包ID(PackageId Guid)
    包编码(PackageCode String)
    送出记录ID(DispatchRecordId Guid)
    送出记录号(DispatchRecordNo String)
    撤销时间(CancelTime DateTime)
    撤销操作人(OperId Guid)
]
InitiatorExternalSystem --> CancelSpecimenPackageDispatchCommand
InitiatorUser --> CancelSpecimenPackageDispatchCommand
CancelSpecimenPackageDispatchCommand ..> SpecimenPackageDispatchCancelledEvent : send

Command('MarkDispatchRecordCancelledCommand')[
    标记送出记录已撤销
    --入参--
    送出记录ID(DispatchRecordId Guid)
    撤销原因(CancelReason DispatchCancelReason)
    撤销说明(CancelDescription String?)
    撤销时间(CancelTime DateTime)
    操作人(OperId Guid)
    操作时间(OperTime DateTime)
]
DomainEvent('DispatchRecordCancelledEvent','送出记录已撤销')
MarkDispatchRecordCancelledCommand ..> DispatchRecordCancelledEvent : send

Command('MarkSpecimenPackagePendingDispatchCommand')[
    标记样本包回到未送出
    --入参--
