@startuml Application
!include ddd_lib.puml
' 聚合根：ApplicationAggregate；业务范围：申请单、申请项目、样本、样本包、送出、接收、异常、报告和单据状态汇总；既有业务事件可作为其他聚合的触发来源，但本文件不定义外部推送记录或平台消息聚合。


Person('InitiatorExternalSystem','发起方侧外部接入系统')
Person('InitiatorUser','发起机构用户')
Person('ReceiverUser','接收方用户')
Person('ReceiverExternalSystem','接收方侧外部接入系统')
Person('PlatformOperator','平台运营人员')

' 对外写边界：I04-01 至 I04-19 的 JSON 写操作由 ExternalApplicationAppService 自动路由
' /Api/ExternalApplication/{Method} 承载；其入口请求仅映射到下列 Command/FacadeCommand。
' PDF 上传为 ExternalReportFileController 的 multipart 传输特例，仍调用 ExternalApplicationAppService；页面 AppService 不复用 External Request/Result/DTO。

'============================================= 枚举 =============================================
Enum('ApplicationStateEnum')[
    申请单状态
    --属性--
    待审核(PendingReview 1)
    已驳回(ReviewRejected 2)
    审核通过(Approved 3)
    部分送出(PartiallyDispatched 4)
    全部送出(AllDispatched 5)
    部分接收(PartiallyReceived 6)
    全部接收(AllReceived 7)
    检测中(Testing 8)
    检测完成(Completed 9)
    已关闭(Closed 10)
    已取消(Cancelled 11)
]

Enum('ApplicationReviewResultEnum')[
    申请审核结果
    --属性--
    审核通过(Approved 1)
    驳回(Rejected 2)
]

Enum('BarcodeStatusEnum')[
    样本有效状态
    --属性--
    有效(Valid 1)
    已结束(Ended 2)
]

Enum('BarcodeEndTypeEnum')[
    结束类型
    --属性--
    发起方终止(InitiatorTerminated 1)
    样本无法继续检测(UnprocessableSpecimen 2)
]

Enum('BarcodeTerminationTypeEnum')[
    终止类型
    --属性--
    未送出终止(BeforeDispatch 1)
    送出后终止(AfterDispatch 2)
]

Enum('BarcodeTerminationReasonEnum')[
    终止原因
    --属性--
    申请信息错误(ApplicationInfoError 1)
    患者信息变更(PatientInfoChanged 2)
    不再需要检测(NoLongerNeeded 3)
    重复申请(DuplicateApplication 4)
    费用或结算原因(FeeOrSettlement 5)
    其他(Other 6)
]

Enum('ApplicationCancelReasonEnum')[
    申请取消原因
    --属性--
    申请信息错误(ApplicationInfoError 1)
    患者信息变更(PatientInfoChanged 2)
    不再需要检测(NoLongerNeeded 3)
    重复申请(DuplicateApplication 4)
    费用或结算原因(FeeOrSettlement 5)
    其他(Other 6)
]

Enum('SpecimenMainStatusEnum')[
    样本主状态
    --属性--
    待送出(PendingDispatch 1)
    已送出(Dispatched 2)
    已接收(Received 3)
    检测中(Testing 4)
    检测完成(Completed 5)
]

Enum('DispatchRecordStatusEnum')[
    送出记录状态
    --属性--
    已送出(Dispatched 1)
    接收完成(ReceiptCompleted 2)
    全部撤回(AllWithdrawn 3)
    已撤销(Cancelled 4)
]

Enum('ReceiptResultEnum')[
    接收处理结果
    --属性--
    正常接收(Normal 1)
    异常接收(Exceptional 2)
    未到货(NotArrived 3)
]

Enum('FinalReceiptConclusionEnum')[
    最终接收结论
    --属性--
    正常接收(Normal 1)
    异常接收(Exceptional 2)
]

Enum('SpecimenExceptionStatusEnum')[
    异常状态
    --属性--
    待处理(Pending 1)
    已关闭(Closed 2)
]

Enum('SpecimenExceptionSourceEnum')[
    异常来源
    --属性--
    异常接收(ExceptionalReceipt 1)
    未到货(NotArrived 2)
    接收后页面登记(PostReceiptManual 3)
]

Enum('SpecimenExceptionProcessResultEnum')[
    异常处理结果
    --属性--
    继续检测(ContinueTesting 1)
    无法继续检测(Unprocessable 2)
    关闭异常(CloseException 3)
]

Enum('LabReportStatusEnum')[
    报告状态
    --属性--
    已发布(Published 1)
    已作废(Voided 2)
]

Enum('LabResultTypeEnum')[
    报告结果类型
    --属性--
    数值(Numeric 1)
    定性(Qualitative 2)
    文本(Text 3)
]

Enum('VisitTypeEnum')[
    就诊类型
    --属性--
    门诊(Outpatient 1)
    住院(Inpatient 2)
    体检(PhysicalExam 3)
    急诊(Emergency 4)
    其他(Other 5)
    未知(Unknown 6)
]

Enum('FeeStatusEnum')[
    费用状态
    --属性--
    已收费(Charged 1)
    未收费(Uncharged 2)
    无需收费(NoChargeRequired 3)
    未知(Unknown 4)
]

Enum('InsurancePaidStatusEnum')[
    是否医保支付
    --属性--
    是(Yes 1)
    否(No 2)
    未知(Unknown 3)
]

Enum('InsuranceTypeEnum')[
    医保类型
    --属性--
    职工医保(Employee 1)
    居民医保(Resident 2)
    商保(Commercial 3)
    自费(SelfPay 4)
    其他(Other 5)
    未知(Unknown 6)
]

Enum('SpecimenPackageStatusEnum')[
    包状态
    --属性--
    有效(Valid 1)
    已作废(Voided 2)
]

Enum('PackageHandoverStatusEnum')[
    包交接状态
    --属性--
    未送出(PendingDispatch 1)
    已送出(Dispatched 2)
    已接收(Received 3)
]

Enum('PackageAdjustActionEnum')[
    包内样本调整动作
    --属性--
    加入样本(AddSpecimen 1)
    移出样本(RemoveSpecimen 2)
]

Enum('PackageSpecimenSupplementReasonEnum')[
    已送出包样本补录原因
    --属性--
    线下包内实物多于系统清单(PhysicalPackageExtraSpecimen 1)
    系统漏登记(SystemOmission 2)
    其他(Other 3)
]

Enum('SpecimenPackageVoidReasonEnum')[
    包作废原因
    --属性--
    样本信息错误(SpecimenInfoError 1)
    包内容变更(PackageContentChanged 2)
    不再需要送出(NoLongerNeedDispatch 3)
    其他(Other 4)
]

Enum('DispatchCancelReasonEnum')[
    撤销包送出原因
    --属性--
    误操作送出(MistakenDispatch 1)
    线下未实际发出(NotPhysicallySent 2)
    包内容需调整(PackageContentNeedsAdjustment 3)
    其他(Other 4)
]

'============================================= 创建申请 =============================================
FacadeCommand('CreateApplicationCommand')[
    创建患者级申请单
    --入参--
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    发起方申请单号(InitiatorApplicationNo String?)
    患者姓名(PatientName String)
    患者性别(PatientGender String)
    患者出生日期(PatientBirthDate DateTime?)
    发起方患者标识(InitiatorPatientKey String?)
    证件号(PatientIdCardNo String?)
    联系电话(PatientPhoneNumber String?)
    就诊类型(VisitType VisitType)
    发起方就诊标识(InitiatorVisitKey String?)
    门诊号(OutpatientNo String?)
    住院号(InpatientNo String?)
    体检号(PhysicalExamNo String?)
    病区编码(WardCode String?)
    病区名称(WardName String?)
    床号(BedNo String?)
    就诊时间(VisitTime DateTime?)
    开单时间(OrderingTime DateTime?)
    发起科室ID(InitiatorDeptId Guid)
    发起医生ID(InitiatorDoctorId Guid)
    主诉(ChiefComplaint Text?)
    既往史(PastHistory Text?)
    诊断编码(DiagnosisCode String?)
    诊断名称(Diagnosis String?)
    诊断描述(DiagnosisDescription Text?)
    临床备注(ClinicalRemark Text?)
    是否绿色通道(IsGreenChannel Boolean)
    绿色通道说明(GreenChannelDescription Text?)
    申请项目明细(Items ApplicationItemCreateItem[])
    备注(Remark String?)
    --规则--
    1.一次只创建一张患者级申请单，不做业务幂等
    2.创建阶段不生成样本条码，不接收样本信息或样本条码
    3.整单原子校验启用协作关系、全部发起方项目对照和全部接收院区可承接项目实际可用性；任一项目失败时不生成申请单及任何相关记录
    4.对外请求只提交接收方和申请业务内容；发起医院、发起院区、发起科室和发起医生由 token 解析后写入本命令
    5.创建成功后 ApplicationState=PendingReview
    6.发起科室只保存 InitiatorDeptId，不保留开单科室、送检科室或发起科室编码
    7.发起医生只保存 InitiatorDoctorId，不接收或保存医生编码、医生姓名
    8.项目项只接收发起项目编码，发起项目名称由院区项目对照补齐
    9.全部项目校验失败时逐项返回未通过项目和原因，不支持部分项目通过
    10.创建时只保存发起方项目到标准医疗项目的匹配结果，不保存接收院区项目或承接配置快照
    11.医院、院区和科室名称不持久化，查询时通过 IOrganizationAppService 解析最新名称
]
DomainEvent('ApplicationCreatedEvent')[
    申请单已创建
    --属性--
    平台申请单号(ApplicationNo String)
    发起方申请单号(InitiatorApplicationNo String?)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    当前单据状态(ApplicationState ApplicationState)
    创建时间(CreatedTime DateTime)
]
InitiatorExternalSystem --> CreateApplicationCommand
CreateApplicationCommand ..> ApplicationCreatedEvent : send

'============================================= 申请取消 =============================================
Command('CancelApplicationCommand')[
    取消申请
    --入参--
    平台申请单号(ApplicationNo String)
    取消原因(CancelReason ApplicationCancelReason)
    取消说明(CancelDescription String?)
    取消发起方(CancelledByOrg String)
    取消时间(CancelTime DateTime)
    --规则--
    1.仅待审核且尚未形成样本条码的申请单可取消
    2.发起医院和发起院区由有效Token中的HosId、BranchId解析，按平台申请单号查询后校验申请属于当前发起方，不接收调用方提交的发起组织身份字段
    3.取消原因=其他时取消说明必填
    4.成功后 ApplicationState=Cancelled，不生成样本条码，不调用接收方条码生成接口
    5.已取消申请不得审核通过或驳回
    6.审核通过并形成样本条码后不再支持申请单级取消，后续停止流转应执行样本终止或异常处理
    7.取消申请不触发本阶段外部推送
]
DomainEvent('ApplicationCancelledEvent')[
    申请单已取消
    --属性--
    平台申请单号(ApplicationNo String)
    发起方申请单号(InitiatorApplicationNo String?)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    发起科室ID(InitiatorDeptId Guid?)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    取消原因(CancelReason ApplicationCancelReason)
    取消说明(CancelDescription String?)
    取消发起方(CancelledByOrg String)
    取消时间(CancelTime DateTime)
    当前单据状态(ApplicationState ApplicationState)
]
InitiatorExternalSystem --> CancelApplicationCommand
InitiatorUser --> CancelApplicationCommand
CancelApplicationCommand ..> ApplicationCancelledEvent : send

'============================================= 审核与样本形成 =============================================
FacadeCommand('ApproveApplicationCommand')[
    审核通过并形成样本
    --入参--
    ID(Id Guid)
    ..
    审核备注(ReviewRemark String?)
    审核人ID(ReviewerId String)
    审核人(ReviewerName String)
    审核时间(ReviewTime DateTime)
    --规则--
    1.仅 PendingReview 且未取消、未形成样本条码的申请单可审核通过
    2.使用申请创建时保存的标准项目快照，一次匹配当前接收医院和接收院区的启用项目对照
    3.每个标准项目必须唯一匹配编码和名称完整的接收方项目，否则在外部调用前失败
    4.后端只发送接收方项目编码、名称和加急标识，审核页面和审核接口不提交条码结果
    5.接口失败、超时、返回空、接收方项目覆盖未知重复遗漏或内容不合法时本命令失败
    6.失败时申请单保持 PendingReview，不生成样本条码，不触发审核通过外部推送
    7.成功时将接收方项目覆盖关系转换为申请项目覆盖关系，保存样本和样本覆盖项目明细
    8.所有样本 BarcodeStatus=Valid、SpecimenMainStatus=PendingDispatch
    9.成功后 ApplicationState=Approved
]
DomainEvent('ApplicationApprovedEvent')[
    申请单审核通过
    --属性--
    申请单ID(ApplicationId Guid)
    平台申请单号(ApplicationNo String)
    发起方申请单号(InitiatorApplicationNo String?)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    发起科室ID(InitiatorDeptId Guid?)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    审核结果(ReviewResult ApplicationReviewResult)
    审核人ID(ReviewerId String)
    审核人(ReviewerName String)
    审核时间(ReviewTime DateTime)
    --规则--
    1.事件表达申请单级审核通过事实，不承担条码清单通知职责
    2.外部推送策略每次事件只形成一条申请单级通知，不携带样本条码或条码列表
]
ReceiverUser --> ApproveApplicationCommand
ApproveApplicationCommand ..> ApplicationApprovedEvent : send

Command('RejectApplicationCommand')[
    驳回
    --入参--
    ID(Id Guid)
    ..
    驳回备注(ReviewRemark String)
    审核人ID(ReviewerId String)
    审核人(ReviewerName String)
    审核时间(ReviewTime DateTime)
    --规则--
    1.仅 PendingReview 且未取消、未形成样本条码的申请单可驳回
    2.审核备注必填，页面显示为驳回备注
    3.成功后 ApplicationState=ReviewRejected，不生成样本条码，且不得再审核通过
]
DomainEvent('ApplicationRejectedEvent')[
    申请单驳回
    --属性--
    申请单ID(ApplicationId Guid)
    平台申请单号(ApplicationNo String)
    发起方申请单号(InitiatorApplicationNo String?)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    发起科室ID(InitiatorDeptId Guid?)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    审核结果(ReviewResult ApplicationReviewResult)
    审核人ID(ReviewerId String)
    审核人(ReviewerName String)
    驳回备注(ReviewRemark String)
    审核时间(ReviewTime DateTime)
]
ReceiverUser --> RejectApplicationCommand
RejectApplicationCommand ..> ApplicationRejectedEvent : send

'============================================= 样本打包 =============================================
FacadeCommand('CreateSpecimenPackageCommand')[
    创建样本包
    --入参--
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    包名称(PackageName String)
    样本ID列表(SpecimenIds Guid[])
    备注(Remark String?)
    --规则--
    1.一个包表示一次性运送的样本集合，只能包含同一发起医院、发起院区、接收医院、接收院区的样本
    2.包内样本可以来自多个申请单，PackageSpecimenEntity 通过 ApplicationId 和 SpecimenId 关联来源单据与样本
    3.样本条码是展示和外部识别字段，不作为聚合内部关联主键
    4.只有有效且待送出的样本可入包
    5.包编码可打印为二维码或条形码贴在线下实体包装上，用于接收方扫码查询和包接收确认
]
DomainEvent('SpecimenPackageCreatedEvent')[
    样本包已创建
    --属性--
    包ID(PackageId Guid)
    包编码(PackageCode String)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    样本ID列表(SpecimenIds Guid[])
    创建时间(CreatedTime DateTime)
]
InitiatorUser --> CreateSpecimenPackageCommand
InitiatorExternalSystem --> CreateSpecimenPackageCommand
CreateSpecimenPackageCommand ..> SpecimenPackageCreatedEvent : send

Command('AdjustSpecimenPackageCommand')[
    更新当前包内样本清单
    --入参--
    包ID(PackageId Guid)
    调整动作(AdjustAction PackageAdjustAction)
    样本ID列表(SpecimenIds Guid[])
    备注(Remark String?)
    调整时间(AdjustedTime DateTime)
    --规则--
    1.仅有效且未送出的包允许调整
    2.调整不修改样本业务状态
    3.平台只保存调整后的当前有效包内样本清单，不维护包内样本调整记录
]
DomainEvent('SpecimenPackageAdjustedEvent','样本包已调整')
InitiatorUser --> AdjustSpecimenPackageCommand
InitiatorExternalSystem --> AdjustSpecimenPackageCommand
AdjustSpecimenPackageCommand ..> SpecimenPackageAdjustedEvent : send

FacadeCommand('DispatchSpecimenPackageCommand')[
    按包送出
    --入参--
    包ID(PackageId Guid)
    送出时间(DispatchTime DateTime)
    送出备注(DispatchRemark String?)
    --规则--
    1.普通样本送出仅支持按包送出；单个样本也必须先创建仅包含该样本的包
    2.包送出不接收样本条码列表作为入口入参，按包内当前有效样本清单执行
    3.整包校验，任一样本不满足条件时整体失败
    4.成功后锁定包内样本清单、包交接状态变为已送出、追加送出记录和送出样本明细，并将包内样本主状态推进为已送出
    5.普通按包送出形成的送出样本明细 DispatchTime 等于送出记录 DispatchTime，IsSupplemented=false
    6.已送出未接收包补录样本是原线下包漏登记纠错，不属于独立补送或按条码直接送出
    7.包送出与样本状态推进、单据状态重算在同一主聚合内同步完成，不使用 DomainEvent + Policy 推进主流程
]
DomainEvent('SpecimenPackageDispatchedEvent')[
    样本包已送出
    --属性--
    包ID(PackageId Guid)
    包编码(PackageCode String)
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    接收医院编码(ReceiverHospitalCode String)
    接收院区编码(ReceiverBranchCode String)
    样本ID列表(SpecimenIds Guid[])
    送出时间(DispatchTime DateTime)
]
InitiatorUser --> DispatchSpecimenPackageCommand
InitiatorExternalSystem --> DispatchSpecimenPackageCommand
DispatchSpecimenPackageCommand ..> SpecimenPackageDispatchedEvent : send

Command('MarkSpecimenPackageDispatchedCommand')[
    标记样本包已送出
    --入参--
    包ID(PackageId Guid)
    送出时间(DispatchTime DateTime)
]
DomainEvent('SpecimenPackageMarkedDispatchedEvent','样本包交接状态已变为已送出')
MarkSpecimenPackageDispatchedCommand ..> SpecimenPackageMarkedDispatchedEvent : send

FacadeCommand('SupplementDispatchedPackageSpecimensCommand')[
    已送出包补录样本
    --入参--
    发起医院编码(InitiatorHospitalCode String)
    发起院区编码(InitiatorBranchCode String)
    包编码(PackageCode String)
    样本条码列表(SpecimenBarcodes String[])
    补录送出时间(SupplementDispatchTime DateTime?)
    补录原因(SupplementReason PackageSpecimenSupplementReason)
    补录说明(SupplementDescription String?)
    补录时间(SupplementTime DateTime)
    补录来源(SupplementSource String?)
    --规则--
    1.仅允许有效、已送出且未接收包补录样本，不回退包交接状态
    2.按发起医院编码、发起院区编码和包编码定位包；外部接口不接收包ID或平台内部标识
    3.样本必须有效且主状态为待送出，发起方和接收方与包一致，且不属于其他有效未送出包或有效已送出未接收包
    4.样本不得已结束、已接收、检测中、检测完成或已形成报告
    5.补录仅用于线下实体原包实际存在但系统漏登记的纠错，不用于补送
    6.成功后追加包内样本引用和送出样本明细，补录样本进入该包当前应接收清单
    7.补录样本的 DispatchSpecimen.DispatchTime 取 SupplementDispatchTime；未传时取 SupplementTime
]
DomainEvent('DispatchedPackageSpecimensSupplementedEvent')[
    已送出包样本已补录
    --属性--
    包ID(PackageId Guid)
    包编码(PackageCode String)
