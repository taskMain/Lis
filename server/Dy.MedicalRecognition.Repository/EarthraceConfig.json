    {
      "Alias": "Default",
      "Properties": {
        "DbConnection": "User Id=dysoft; Password=dysoft; Data Source=(DESCRIPTION=(ADDRESS=(PROTOCOL=tcp)(HOST=192.168.1.19)(PORT=1521))(CONNECT_DATA=(SERVICE_NAME=orcl)))"
      },
      "Settings": {
        "IgnoreParameterCase": "true"
      },
      "Database": {
        "DbProvider": {
          "Name": "Oracle"
        },
        "Write": {
          "Name": "WriteDB",
          "ConnectionString": "${DbConnection}"
        }
      },
      "Converters": [
        {
          "Name": "DelimiterConverter", //自动将表字段名转换为对应的Pascal命名格式并映射到实体
          "IsDefault": true,
          "Tokenizer": {
            "Name": "Default",
            "Properties": {
              "Delimiter": "_",
              "UppercaseSplit": false
            }
          },
          "Converter": {
            "Name": "Pascal"
          }
        }
      ]
    }
  ]
}
