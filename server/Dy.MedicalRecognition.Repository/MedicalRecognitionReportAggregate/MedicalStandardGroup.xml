<SqlMap Scope="MedicalStandardGroup" xmlns="http://dysoft.vip/schemas/EarthraceSqlMap.xsd">
  <Statements>
    <!--
      功能：定义标准项目分组的通用查询字段清单，供按主键查询和全量查询语句复用。
      结果：输出分组标识、所属分类标识、分组名称、启用状态、备注和操作审计字段，各字段业务含义见行内注释。
    -->
    <Statement Id="MedicalStandardGroupColumns">
      id,          <!-- 分组标识（主键） -->
      category_id, <!-- 所属分类标识 -->
      name,        <!-- 分组名称，同一分类内唯一 -->
      is_valid,    <!-- 是否启用 -->
      remark,      <!-- 备注 -->
      oper_id,     <!-- 操作人标识 -->
      oper_time    <!-- 操作时间 -->
    </Statement>
    <!--
      功能：查询标准项目分组的全部记录，用于不区分启用状态地读取分组全量数据。
      结果：返回分组的完整字段清单，不接收任何筛选参数，也没有显式排序，返回顺序由数据库决定、调用方不得依赖。
    -->
    <Statement Id="QueryAllMedicalStandardGroup">
      select
      <Include RefId="MedicalStandardGroupColumns" />
      from mrec_medical_standard_group
    </Statement>
    <!--
      功能：新增一条标准项目分组，并归属到指定分类下。
      结果：写入分组标识、所属分类标识、分组名称、备注和操作审计字段；启用状态固定为启用、操作时间取数据库当前时间，均不接受请求参数。
    -->
    <Statement Id="CreateMedicalStandardGroup">
      insert into mrec_medical_standard_group (
        id,           <!-- 分组标识（主键），由仓储在插入前生成 -->
        category_id,  <!-- 所属分类标识 -->
        name,         <!-- 分组名称，同一分类内唯一 -->
        is_valid,     <!-- 是否启用，新增固定写入 true -->
        remark,       <!-- 备注 -->
        oper_id,      <!-- 操作人标识 -->
        oper_time     <!-- 操作时间，取数据库当前时间 -->
      ) values ($Id, $CategoryId, $Name, true, $Remark, $OperId, current_timestamp)
    </Statement>
    <!--
      功能：按分组标识修改标准项目分组的名称和备注。
      结果：只影响主键命中的一行，同时刷新操作人和操作时间；所属分类不可变更（分组不能跨分类移动），启用状态由启用/停用语句单独维护。
    -->
    <Statement Id="UpdateMedicalStandardGroup">
      update mrec_medical_standard_group set
        name = $Name,                   <!-- 分组名称，同一分类内唯一 -->
        remark = $Remark,               <!-- 备注 -->
        oper_id = $OperId,              <!-- 操作人标识 -->
        oper_time = current_timestamp   <!-- 操作时间，取数据库当前时间 -->
      where id = $Id
    </Statement>
    <!--
      功能：将指定标准项目分组由停用改为启用，并记录本次操作人和操作时间。
      结果：仅当该分组当前处于停用态时才更新；重复启用不产生额外更新、影响 0 行，调用方据此判定无需重复处理。
    -->
    <Statement Id="EnableMedicalStandardGroup">
      update mrec_medical_standard_group set
        is_valid = true,                <!-- 是否启用，置为启用 -->
        oper_id = $OperId,              <!-- 操作人标识 -->
        oper_time = current_timestamp   <!-- 操作时间，取数据库当前时间 -->
      where id = $Id and is_valid = false
    </Statement>
    <!--
      功能：将指定标准项目分组由启用改为停用，并记录本次操作人和操作时间。
      结果：仅当该分组当前处于启用态时才更新；重复停用不产生额外更新、影响 0 行。
    -->
    <Statement Id="DisableMedicalStandardGroup">
      update mrec_medical_standard_group set
        is_valid = false,               <!-- 是否启用，置为停用 -->
        oper_id = $OperId,              <!-- 操作人标识 -->
        oper_time = current_timestamp   <!-- 操作时间，取数据库当前时间 -->
      where id = $Id and is_valid = true
    </Statement>
    <!--
      功能：按分组标识读取单个标准项目分组的完整信息，供修改、启用、停用前的存在性判断与业务校验使用。
      结果：命中时返回一行分组字段清单，未命中时返回空结果；启用中的分组和已停用的分组都会被返回。
    -->
    <Statement Id="GetMedicalStandardGroupById">
      select <Include RefId="MedicalStandardGroupColumns" /> from mrec_medical_standard_group where id = $Id
    </Statement>
    <!--
      功能：统计同一分类下与待校验分组名称同名的分组条数，用于新增和改名前的分组名称重名校验。
      结果：返回同名条数（只计数、不返回明细），调用方以大于 0 判定名称已被占用；分组名称在同一分类内唯一、跨分类允许重名，且校验不区分启用状态。
    -->
    <Statement Id="MedicalStandardGroupNameExists">
      select count(1) from mrec_medical_standard_group where category_id = $CategoryId and name = $Name
      <!--
        处理：仅当传入被排除的分组标识（改名场景传入分组自身标识）时追加主键不等条件。
        结果：改名时不会把自身记录误判为同名冲突；新增时该分支不参与拼接。
      -->
      <IsNotEmpty Prepend="and" Property="ExcludedId">id &lt;&gt; $ExcludedId</IsNotEmpty>
    </Statement>
  </Statements>
</SqlMap>
