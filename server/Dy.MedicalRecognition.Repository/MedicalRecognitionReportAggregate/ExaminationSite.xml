<SqlMap Scope="ExaminationSite" xmlns="http://dysoft.vip/schemas/EarthraceSqlMap.xsd">
  <Statements>
    <!--
      功能：定义检查部位的通用查询字段清单，供按检查项目读取语句与新增语句复用。
      结果：输出检查项目归属、来源部位编码、部位名称与操作审计字段。
    -->
    <Statement Id="ExaminationSiteColumns">
      id,                     <!-- 检查部位标识（主键） -->
      examination_item_id,    <!-- 检查项目标识，检查部位的固定归属 -->
      source_site_code,       <!-- 来源部位编码 -->
      site_name,              <!-- 部位名称 -->
      oper_id,                <!-- 操作人标识 -->
      oper_time               <!-- 操作时间 -->
    </Statement>
    <!--
      功能：按检查项目读取检查部位，供管理端版本详情在该项目下展示部位。
      结果：返回该项目下的全部检查部位，按部位标识升序保证顺序稳定；项目没有明确部位时返回空集合。
    -->
    <Statement Id="QueryExaminationSitesByItem">
      select <Include RefId="ExaminationSiteColumns" /> from mrec_examination_site
      where examination_item_id = $ExaminationItemId  <!-- 归属范围：只返回该检查项目下的部位 -->
      order by id asc  <!-- 排序：按部位标识升序，保证同一项目内的返回顺序稳定 -->
    </Statement>
    <!--
      功能：按检查项目标识集合读取检查部位，供互认匹配查询按本次命中的检查项目一次取回项目级内容。
      结果：返回集合内命中的全部检查部位，每个部位都带其检查项目归属，调用方据此把部位归到对应的命中项目下；
      集合内不存在的项目不产生行；排序按检查项目标识升序、部位标识升序，使同一批的返回顺序稳定。
    -->
    <Statement Id="QueryExaminationSitesByItems">
      select <Include RefId="ExaminationSiteColumns" /> from mrec_examination_site
      <!-- 集合筛选：参数名直接跟在 in 之后、不带括号，由框架展开为值列表；空集合展开为空列表，不返回任何行 -->
      where examination_item_id in $ExaminationItemIds
      order by examination_item_id asc, id asc  <!-- 排序：按检查项目标识升序、部位标识升序，保证同一批内的返回顺序稳定 -->
    </Statement>
    <!--
      功能：新增一条检查部位。
      结果：写入标识、检查项目归属、来源部位编码、部位名称与操作字段；部位随所属项目保存，不在报告中重复归属。
    -->
    <Statement Id="CreateExaminationSite">
      insert into mrec_examination_site (
        id, examination_item_id, source_site_code, site_name, oper_id, oper_time
      ) values ($Id, $ExaminationItemId, $SourceSiteCode, $SiteName, $OperId, $OperTime)
    </Statement>
  </Statements>
</SqlMap>
